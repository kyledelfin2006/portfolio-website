---
import SectionHeading from './SectionHeading.astro';
import { getRequiredEntry } from '../content/load';
import type { TextEntryOf } from '../content/load';
interface Props {
  entry: TextEntryOf<'about'>;
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
const { data: site } = await getRequiredEntry('site', 'site');
const contactProfiles = site.profiles.filter(({ label }) => data.contactProfileLabels?.includes(label));
---
<section>
  <SectionHeading title={data.title} />
  {data.itemTitle && <div class="split-row"><h3>{data.itemTitle}</h3>{data.meta && <span class="meta">{data.meta}</span>}</div>}
  {data.pullQuote && <figure class="pull-quote" aria-hidden="true">
    <blockquote class="pull-quote-text">{data.pullQuote.lead} <mark>{data.pullQuote.emphasis}</mark></blockquote>
    <div class="bounds">{data.pullQuote.boxes.map((box, index) => <>{index > 0 && <i class="bounds-link" style={`--i:${index * 2 - 1}`}></i>}<span class="bounds-box" style={`--i:${index * 2}`}>{box}</span></>)}</div>
  </figure>}
  <Content />
  {data.contactProfileLabels && <div class="contact-links">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    {contactProfiles.map((profile) => <><span aria-hidden="true">·</span><a href={profile.url} target="_blank" rel="noopener noreferrer">{profile.label}</a></>)}
  </div>}
</section>
