---
import SectionHeading from './SectionHeading.astro';
const skills = [
  ['Languages', 'Java (21+), Python (3.x), SQL, Bash'],
  ['Backend', 'Spring Boot (3.x), Spring MVC, Spring Data JPA, Spring Security, Hibernate, REST APIs'],
  ['Databases', 'PostgreSQL, MySQL, SQLite, Flyway'],
  ['Cloud & DevOps', 'Docker, AWS (learning), Linux (Mint / Ubuntu), Git, GitHub, Maven'],
  ['Testing & Tools', 'JUnit 5, Mockito, Swagger / OpenAPI, Postman, IntelliJ IDEA, PyCharm'],
];
---
<section aria-label="Technical skills">
  <SectionHeading title="Technical Skills" />
  <dl class="skills">{skills.map(([label, value]) => <div><dt>{label}:</dt> <dd>{value}</dd></div>)}</dl>
</section>
