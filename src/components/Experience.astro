---
import SectionHeading from './SectionHeading.astro';
import { getEntries } from '../content/load';
interface Props { heading: string; ariaLabel: string; id?: string; }
const { heading, ariaLabel, id } = Astro.props;
const entries = await getEntries('experience');
---
<section id={id} class="experience" aria-label={ariaLabel}>
  <SectionHeading title={heading} />
  <div class="entries">
    {await Promise.all(entries.map(async ({ data, render }) => {
      const { Content } = await render();
      return <article>
        <div class="split-row">
          <div>
            <h3>{data.title}</h3>
            {data.date && <p class="entry-subtitle">{data.date}</p>}
          </div>
          <div class="experience-organization">
            {data.logo && <span class="experience-logo"><img src={data.logo.path} alt={data.logo.alt} width={data.logo.width} height={data.logo.height} loading="lazy" decoding="async" /></span>}
            <span class="meta">{data.organization}</span>
          </div>
        </div>
        <Content />
      </article>;
    }))}
  </div>
</section>

<style>
  .experience .split-row { align-items: flex-start; }
</style>
