---
interface Props { labels: { lightMode: string; darkMode: string; switchToLight: string; switchToDark: string }; }
const { labels } = Astro.props;
---
<button id="theme-toggle" type="button" aria-label={labels.switchToLight} aria-pressed="false" hidden
  data-light-mode={labels.lightMode} data-dark-mode={labels.darkMode}
  data-switch-light={labels.switchToLight} data-switch-dark={labels.switchToDark}>
  <span class="toggle-marker" aria-hidden="true">◐</span><span id="theme-label">{labels.lightMode}</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const label = document.querySelector<HTMLElement>('#theme-label');
  const root = document.documentElement;
  const shell = document.querySelector<HTMLElement>('.document-shell');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const transitionDuration = 220;
  let transitionActive = false;
  let queuedToggle = false;

  function syncThemeControl() {
    const light = !root.classList.contains('dark');
    button?.setAttribute('aria-pressed', String(light));
    button?.setAttribute('aria-label', light ? button.dataset.switchDark! : button.dataset.switchLight!);
    if (label) label.textContent = light ? button?.dataset.darkMode ?? '' : button?.dataset.lightMode ?? '';
  }

  function applyThemeToggle() {
    const dark = root.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch { /* Storage is optional. */ }
    syncThemeControl();
  }

  function finishTransition() {
    root.classList.remove('theme-transition');
    transitionActive = false;
    if (queuedToggle) {
      queuedToggle = false;
      toggleTheme();
    }
  }

  function toggleTheme() {
    if (transitionActive) {
      queuedToggle = !queuedToggle;
      return;
    }

    if (reducedMotion.matches || !shell) {
      applyThemeToggle();
      return;
    }

    transitionActive = true;
    root.classList.add('theme-transition');

    let fallbackTimer: number;
    const completeTransition = () => {
      shell.removeEventListener('animationend', completeTransition);
      window.clearTimeout(fallbackTimer);
      finishTransition();
    };
    fallbackTimer = window.setTimeout(completeTransition, transitionDuration + 80);
    shell.addEventListener('animationend', completeTransition, { once: true });

    requestAnimationFrame(() => applyThemeToggle());
  }

  if (button) {
    button.hidden = false;
    syncThemeControl();
    button.addEventListener('click', toggleTheme);
  }
</script>
