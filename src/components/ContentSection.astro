---
import Education from './Education.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import Skills from './Skills.astro';
import Workshops from './Workshops.astro';
import Honors from './Honors.astro';
import AboutSection from './AboutSection.astro';
import { getRequiredEntry } from '../content/load';
import type { SectionId } from '../content/sections';
interface Props { section: SectionId; heading?: string; ariaLabel?: string; description?: string; compactProjects?: boolean; }
const { section, heading, ariaLabel, description, compactProjects = false } = Astro.props;
const proseSections = ['biography', 'engineering-philosophy', 'resume-and-contact'];
const aboutEntry = proseSections.includes(section) ? await getRequiredEntry(`about/${section}`, 'about') : undefined;
if (!aboutEntry && (!heading || !ariaLabel)) throw new Error(`Section "${section}" needs a heading and accessible label.`);
---
{section === 'education' && <Education heading={heading!} ariaLabel={ariaLabel!} id={section} description={description} />}
{section === 'experience' && <Experience heading={heading!} ariaLabel={ariaLabel!} id={section} description={description} />}
{section === 'projects' && <Projects heading={heading!} ariaLabel={ariaLabel!} id={section} compact={compactProjects} description={description} />}
{section === 'skills' && <Skills heading={heading!} ariaLabel={ariaLabel!} id={section} description={description} />}
{section === 'workshops' && <Workshops heading={heading!} ariaLabel={ariaLabel!} id={section} description={description} />}
{section === 'honors' && <Honors heading={heading!} id={section} description={description} />}
{aboutEntry && <AboutSection entry={aboutEntry} />}
