---
import Header from '../components/Header.astro';
import { getRequiredEntry } from '../content/load';
import '../styles/global.css';
interface Props { title: string; description: string; resume?: boolean; }
const { title, description, resume = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const { data: site } = await getRequiredEntry('site', 'site');
// Destination labels shown on the page-transition shutter, mirroring the numbered navigation.
const projectsPath = base + 'projects/';
const labels: Record<string, string> = {};
labels[base] = '01 / ' + site.navigation.main;
labels[base + 'about/'] = '02 / ' + site.navigation.about;
labels[projectsPath] = '03 / ' + site.navigation.projects;
const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const caseSlug = pathname.match(/\/projects\/([^/]+)\/$/)?.[1];
const routeLabel = labels[pathname] ?? (caseSlug ? labels[projectsPath] + ' / ' + caseSlug.replace(/-/g, ' ') : site.fullName);
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <title>{title}</title>
    <script is:inline>
      try {
        document.documentElement.classList.toggle('dark', localStorage.getItem('theme') !== 'light');
      } catch { /* Keep the default dark theme when storage is unavailable. */ }
    </script>
    {resume && <script is:inline>
      try {
        if (!sessionStorage.getItem('resume-intro-seen')) {
          sessionStorage.setItem('resume-intro-seen', '1');
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('intro-active');
            window.setTimeout(() => document.documentElement.classList.remove('intro-active'), 1350);
          }
        }
      } catch { /* Show the page immediately when storage is unavailable. */ }
    </script>}
    <script is:inline>
      try {
        if (!sessionStorage.getItem('name-reveal-seen') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          sessionStorage.setItem('name-reveal-seen', '1');
          const html = document.documentElement;
          html.style.setProperty('--name-delay', html.classList.contains('intro-active') ? '950ms' : '0ms');
          html.classList.add('name-intro');
          window.setTimeout(() => html.classList.remove('name-intro'), 2400);
        }
      } catch { /* The name simply renders without the reveal. */ }
    </script>
    <link rel="expect" href="#main-content" blocking="render" />
    <script is:inline>
      // Route helpers shared by the shutter, the view-transition handoff and the destination label.
      const normalizePath = (path) => path.replace(/\/?$/, '/');
      window.routeKind = (path) => /\/projects\/[^/]+\/$/.test(normalizePath(path)) ? 'case' : /\/about\/$/.test(normalizePath(path)) ? 'about' : 'list';
      window.routeOrder = (path) => {
        const kind = routeKind(path);
        if (kind === 'case') return 3;
        if (kind === 'about') return 1;
        return /\/projects\/$/.test(normalizePath(path)) ? 2 : 0;
      };
      // A project list <-> case study move morphs the shared title and logo; every other move uses the shutter.
      window.canMorph = (from, to) => 'PageRevealEvent' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        [routeKind(from), routeKind(to)].sort().join() === 'case,list';
      const tagShared = (path, otherPath) => {
        const slug = (normalizePath(routeKind(path) === 'case' ? path : otherPath).match(/\/projects\/([^/]+)\/$/) || [])[1];
        if (!slug) return;
        const key = slug.replace(/[^\w-]/g, '-');
        let title, logo;
        if (routeKind(path) === 'case') {
          title = document.querySelector('.case-header h2');
          logo = document.querySelector('.case-header .project-logo');
        } else {
          const link = [...document.querySelectorAll('.entries h3 a')].find((a) => normalizePath(a.pathname).endsWith(`/projects/${slug}/`));
          title = link;
          logo = link?.closest('article')?.querySelector('.project-logo');
        }
        title?.classList.add('vt-title');
        if (title) title.style.viewTransitionName = `pt-${key}`;
        if (logo) logo.style.viewTransitionName = `pl-${key}`;
      };
      window.addEventListener('pageswap', (event) => {
        if (!event.viewTransition) return;
        const entry = event.activation?.entry;
        const to = entry && new URL(entry.url);
        if (!to || to.origin !== location.origin || !canMorph(location.pathname, to.pathname)) { event.viewTransition.skipTransition(); return; }
        tagShared(location.pathname, to.pathname);
      });
      window.addEventListener('pagereveal', (event) => {
        if (!event.viewTransition) return;
        const fromEntry = window.navigation?.activation?.from;
        const from = fromEntry && new URL(fromEntry.url);
        if (!from || from.origin !== location.origin || !canMorph(from.pathname, location.pathname)) { event.viewTransition.skipTransition(); return; }
        tagShared(location.pathname, from.pathname);
        event.viewTransition.finished.finally(() => {
          document.querySelectorAll('.vt-title').forEach((el) => el.classList.remove('vt-title'));
          document.querySelectorAll('[style*="view-transition-name"]').forEach((el) => { el.style.viewTransitionName = ''; });
        });
      });
      try {
        const pending = JSON.parse(sessionStorage.getItem('route-transition') || 'null');
        sessionStorage.removeItem('route-transition');
        if (pending?.path === location.pathname + location.search && Date.now() - pending.at < 10000 &&
            !document.documentElement.classList.contains('intro-active') &&
            !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const html = document.documentElement;
          const morph = canMorph(pending.from, location.pathname);
          html.style.setProperty('--route-dir', String(pending.dir || 1));
          if (!morph) {
            html.classList.add('route-enter');
            window.setTimeout(() => html.classList.remove('route-enter'), 350);
          }
          // Replay the name reveal on every internal page swap, timed to start as the page appears.
          html.style.setProperty('--name-delay', morph ? '260ms' : '200ms');
          html.classList.add('name-intro');
          window.setTimeout(() => html.classList.remove('name-intro'), 2400);
        }
      } catch { /* A failed storage read never hides the page. */ }
    </script>
  </head>
  <body class:list={[{ 'resume-page': resume, 'content-page': !resume }]}>
    <a class="skip-link" href="#main-content">{site.skipLink}</a>
    {resume && <div class="intro-reveal" aria-hidden="true">
      <div class="intro-panel intro-panel-top"><span class="intro-label">00 / {site.fullName}</span><span class="intro-sub">{site.professionalSubtitle}</span></div>
      <div class="intro-panel intro-panel-bottom"></div>
    </div>}
    <div class="route-reveal" aria-hidden="true" data-labels={JSON.stringify(labels)} data-projects={`${base}projects/`} data-fallback={site.fullName}>
      <div class="route-panel route-panel-top"><span class="intro-label">{routeLabel}</span></div>
      <div class="route-panel route-panel-bottom"></div>
    </div>
    <div class="scroll-progress no-print" aria-hidden="true"></div>
    <div class="document-shell">
      <Header />
      <main id="main-content" tabindex="-1"><slot /></main>
      <footer class="no-print"><span>{site.fullName}</span><a href={`${base}resume.pdf`} target="_blank" rel="noopener">{site.downloadResume}</a></footer>
    </div>
    {resume && <script is:inline>
      const root = document.documentElement;
      const reveal = document.querySelector('.intro-reveal');
      const panel = reveal?.querySelector('.intro-panel-top');
      if (root.classList.contains('intro-active') && panel) {
        const finish = () => {
          root.classList.remove('intro-active');
          panel.removeEventListener('animationend', finish);
          document.removeEventListener('pointerdown', finish, true);
          document.removeEventListener('wheel', finish, true);
          window.removeEventListener('keydown', finish, true);
        };
        // The label animations bubble up too; only the panel's own opening ends the intro.
        panel.addEventListener('animationend', (event) => { if (event.target === panel) finish(); });
        document.addEventListener('pointerdown', finish, { capture: true, once: true });
        document.addEventListener('wheel', finish, { capture: true, once: true, passive: true });
        window.addEventListener('keydown', finish, { capture: true, once: true });
      }
    </script>}
    {resume && <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const chips = [];
        document.querySelectorAll('.stat').forEach((el) => {
          const match = el.textContent.match(/^(\d[\d,]*)(.*)$/);
          if (!match) return;
          const target = Number(match[1].replace(/,/g, ''));
          const visible = document.createElement('span');
          const spoken = document.createElement('span');
          visible.setAttribute('aria-hidden', 'true');
          visible.textContent = '0' + match[2];
          spoken.className = 'sr-only';
          spoken.textContent = el.textContent;
          el.textContent = '';
          el.append(visible, spoken);
          chips.push({ el, visible, target, suffix: match[2] });
        });
        const finish = (chip) => { chip.visible.textContent = chip.target.toLocaleString('en-US') + chip.suffix; };
        const counter = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            counter.unobserve(entry.target);
            const chip = chips.find((item) => item.el === entry.target);
            const start = performance.now();
            const tick = (now) => {
              const t = Math.min(1, (now - start) / 900);
              chip.visible.textContent = Math.round(chip.target * (1 - Math.pow(1 - t, 3))).toLocaleString('en-US') + chip.suffix;
              if (t < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        }, { threshold: 0.6 });
        chips.forEach((chip) => counter.observe(chip.el));
        window.addEventListener('beforeprint', () => chips.forEach(finish));
      }
    </script>}
    {resume && <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window && !CSS.supports('animation-timeline: view()')) {
        const targets = document.querySelectorAll('.resume-page #projects .entries > article, .resume-page #honors .entries > article');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -40px 0px', threshold: 0.08 });
        targets.forEach((target) => target.classList.add('scroll-reveal'));
        targets.forEach((target) => observer.observe(target));
      }
    </script>}
    <script is:inline>
      const routeRoot = document.documentElement;
      const routePanel = document.querySelector('.route-panel-top');
      routePanel?.addEventListener('animationend', () => routeRoot.classList.remove('route-enter'));
      let leaveTimer;
      document.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const link = event.target.closest('a[href]');
        if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
        const url = new URL(link.href);
        if (url.origin !== location.origin || !url.pathname.endsWith('/') ||
            url.pathname + url.search === location.pathname + location.search) return;
        if (leaveTimer) { event.preventDefault(); return; }
        // Pager links keep their reading direction; other moves follow the order Main, About, Projects, case study.
        const dir = link.relList.contains('prev') ? -1 : link.relList.contains('next') ? 1 :
          (routeOrder(url.pathname) >= routeOrder(location.pathname) ? 1 : -1);
        try {
          sessionStorage.setItem('route-transition', JSON.stringify({ path: url.pathname + url.search, from: location.pathname, dir, at: Date.now() }));
        } catch { return; }
        // A shared title/logo handoff takes over natively, so skip the shutter.
        if (canMorph(location.pathname, url.pathname)) return;
        event.preventDefault();
        const reveal = document.querySelector('.route-reveal');
        const label = reveal?.querySelector('.intro-label');
        if (reveal && label) {
          const labels = JSON.parse(reveal.dataset.labels);
          const slug = url.pathname.replace(/\/?$/, '/').match(/\/projects\/([^/]+)\/$/)?.[1];
          label.textContent = labels[url.pathname.replace(/\/?$/, '/')] ??
            (slug ? `${labels[reveal.dataset.projects]} / ${slug.replace(/-/g, ' ')}` : reveal.dataset.fallback);
        }
        routeRoot.style.setProperty('--route-dir', String(dir));
        routeRoot.classList.remove('route-enter');
        routeRoot.classList.add('route-leave');
        leaveTimer = window.setTimeout(() => location.assign(url.href), 150);
      });
      window.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !leaveTimer) return;
        window.clearTimeout(leaveTimer);
        leaveTimer = undefined;
        try { sessionStorage.removeItem('route-transition'); } catch { /* The shutter still clears. */ }
        routeRoot.classList.remove('route-leave');
      });
      window.addEventListener('pageshow', () => {
        if (leaveTimer) window.clearTimeout(leaveTimer);
        leaveTimer = undefined;
        routeRoot.classList.remove('route-leave');
      });
    </script>
  </body>
</html>
