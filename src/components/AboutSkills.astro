---
import SectionHeading from './SectionHeading.astro';
interface Props { heading: string; skills: { name: string }[]; }
const { heading, skills } = Astro.props;
---
<section id="technical-skills" aria-label={heading}>
  <SectionHeading title={heading} />
  <ul class="about-skills">
    {skills.map(({ name }) => <li>{name}</li>)}
  </ul>
</section>
