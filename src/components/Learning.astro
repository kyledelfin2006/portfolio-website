---
import { getEntries } from '../content/load';
import SectionHeading from './SectionHeading.astro';
interface Props { heading: string; id?: string; }
const { heading, id } = Astro.props;
const learning = await getEntries('learning');
---
<section id={id} aria-label={heading}>
  <SectionHeading title={heading} />
  <div class="entries">
    {await Promise.all(learning.map(async (entry) => { const { Content } = await entry.render(); return <article>
      <h3>{entry.data.title}</h3>
      <Content />
    </article>; }))}
  </div>
</section>
