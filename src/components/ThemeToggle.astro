---
interface Props { labels: { lightMode: string; darkMode: string; switchToLight: string; switchToDark: string }; }
const { labels } = Astro.props;
---
<button id="theme-toggle" type="button" aria-label={labels.switchToLight} aria-pressed="false" hidden
  data-light-mode={labels.lightMode} data-dark-mode={labels.darkMode}
  data-switch-light={labels.switchToLight} data-switch-dark={labels.switchToDark}>
  <span aria-hidden="true">◐</span> <span id="theme-label">{labels.lightMode}</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const label = document.querySelector<HTMLElement>('#theme-label');
  function syncThemeControl() {
    const light = !document.documentElement.classList.contains('dark');
    button?.setAttribute('aria-pressed', String(light));
    button?.setAttribute('aria-label', light ? button.dataset.switchDark! : button.dataset.switchLight!);
    if (label) label.textContent = light ? button?.dataset.darkMode ?? '' : button?.dataset.lightMode ?? '';
  }
  if (button) {
    button.hidden = false;
    syncThemeControl();
    button.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch { /* Storage is optional. */ }
      syncThemeControl();
    });
  }
</script>
