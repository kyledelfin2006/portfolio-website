---
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { contentId, getEntries, type TextEntryOf } from '../../content/load';
export async function getStaticPaths() {
  return (await getEntries('project')).map((project) => ({ params: { slug: contentId(project).split('/').at(-1) }, props: { project } }));
}
interface Props { project: TextEntryOf<'project'>; }
const { project } = Astro.props;
const { Content } = await project.render();
---
<BlogPostLayout project={project}><Content /></BlogPostLayout>
