---
import ResumeLayout from '../../layouts/ResumeLayout.astro';
import Projects from '../../components/Projects.astro';
import { getRequiredEntry } from '../../content/load';
const pageEntry = await getRequiredEntry('pages/projects', 'page-projects');
const page = pageEntry.data;
const { Content } = await pageEntry.render();
---
<ResumeLayout title={page.title} description={page.description}>
  <div class="page-intro"><p class="eyebrow">{page.eyebrow}</p><Content /></div>
  <Projects heading={page.sectionHeading} ariaLabel={page.sectionAriaLabel} />
</ResumeLayout>
