---
import { getEntries, getRequiredEntry } from '../content/load';
import SectionHeading from './SectionHeading.astro';
interface Props { heading: string; ariaLabel: string; id?: string; }
const { heading, ariaLabel, id } = Astro.props;
const workshops = await getEntries('workshop');
const { data: site } = await getRequiredEntry('site', 'site');
---
<section id={id} aria-label={ariaLabel}>
  <SectionHeading title={heading} />
  <div class="entries">
    {await Promise.all(workshops.map(async ({ data, render }) => { const { Content } = await render(); return <article>
      <div class="split-row"><h3>{data.title}</h3>{data.date && <span class="meta">{data.date}</span>}</div>
      <p class="entry-subtitle">{data.issuerOrOrganizer}</p><Content />
      {data.certificateImages && <div class="workshop-certificates no-print">
        {data.certificateImages.map((certificate) => <figure>
          <a href={`${import.meta.env.BASE_URL}${certificate.certificatePath}`} target="_blank" rel="noopener noreferrer">
            <img src={`${import.meta.env.BASE_URL}${certificate.path}`} alt={certificate.alt} width={certificate.width} height={certificate.height} loading="lazy" />
          </a>
        </figure>)}
      </div>}
      {data.certificatePath && <a class="credential-link" href={`${import.meta.env.BASE_URL}${data.certificatePath}`} target="_blank" rel="noopener noreferrer">{site.credentialLink}</a>}
    </article>; }))}
  </div>
</section>
