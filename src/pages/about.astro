---
import ResumeLayout from '../layouts/ResumeLayout.astro';
import Workshops from '../components/Workshops.astro';
import AboutSection from '../components/AboutSection.astro';
import { getEntries, getRequiredEntry } from '../content/load';
const pageEntry = await getRequiredEntry('pages/about', 'page-about');
const page = pageEntry.data;
const sections = await getEntries('about');
const { data: site } = await getRequiredEntry('site', 'site');
---
<ResumeLayout title={page.title} description={page.description}>
  <div class="about-sections">
    {sections.filter(({ data }) => data.order < page.workshopsOrder).map((entry) => <AboutSection entry={entry} email={site.email} certificateLabel={site.credentialLink} />)}
    <Workshops heading={page.workshopsHeading} ariaLabel={page.workshopsAriaLabel} />
    {sections.filter(({ data }) => data.order > page.workshopsOrder).map((entry) => <AboutSection entry={entry} email={site.email} certificateLabel={site.credentialLink} />)}
  </div>
</ResumeLayout>
