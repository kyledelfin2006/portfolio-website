---
import ResumeLayout from './ResumeLayout.astro';
import { getRequiredEntry, type TextEntryOf } from '../content/load';
interface Props { project: TextEntryOf<'project'>; }
const { project: { data } } = Astro.props;
const { data: site } = await getRequiredEntry('site', 'site');
---
<ResumeLayout title={`${data.title} — ${site.fullName}`} description={data.description}>
  <article class="case-study">
    <a class="back-link no-print" href={import.meta.env.BASE_URL}>{site.projectLinks.returnToResume}</a>
    <header class="case-header">
      <div class="case-header-grid">
        <div>
          <p class="eyebrow">{site.projectLinks.notes} / {data.projectCategory}</p>
          <h2>{data.title}</h2>
          <p class="case-description">{data.description}</p>
          <p class="entry-subtitle project-stack">{data.stack.join(' · ')}</p>
          {data.date && <p class="meta">{data.date}</p>}
          <div class="case-actions no-print">
            <a href={data.repository} target="_blank" rel="noopener noreferrer">{site.projectLinks.viewSource}</a>
            {data.certificatePath && <a href={`${import.meta.env.BASE_URL}${data.certificatePath}`} target="_blank" rel="noopener noreferrer">{site.credentialLink}</a>}
          </div>
        </div>
        {data.logo && <figure class="project-logo"><img src={`${import.meta.env.BASE_URL}${data.logo.path}`} alt={data.logo.alt} width={data.logo.width} height={data.logo.height} decoding="async" /></figure>}
      </div>
    </header>
    <div class="case-body"><slot /></div>
  </article>
</ResumeLayout>
