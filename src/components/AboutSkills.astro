---
import SectionHeading from './SectionHeading.astro';
interface Props { heading: string; skills: { category: string; items: string[] }[]; }
const { heading, skills } = Astro.props;
---
<section id="technical-skills" aria-label={heading}>
  <SectionHeading title={heading} />
  <dl class="about-skills">
    {skills.map(({ category, items }) => <div><dt>{category}</dt><dd>{items.join(', ')}</dd></div>)}
  </dl>
</section>
