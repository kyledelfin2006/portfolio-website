---
import ResumeLayout from '../layouts/ResumeLayout.astro';
import ContentSection from '../components/ContentSection.astro';
import { getRequiredEntry } from '../content/load';
const pageEntry = await getRequiredEntry('pages/about', 'page-about');
const page = pageEntry.data;
---
<ResumeLayout title={page.title} description={page.description}>
  <div class="about-sections">
    {page.sections.map((section) => <ContentSection
      section={section}
      heading={section === 'honors' ? page.honorsHeading : section === 'learning' ? page.learningHeading : section === 'workshops' ? page.workshopsHeading : undefined}
      ariaLabel={section === 'honors' ? page.honorsHeading : section === 'learning' ? page.learningHeading : section === 'workshops' ? page.workshopsAriaLabel : undefined}
    />)}
  </div>
</ResumeLayout>
