---
import { contentId, getEntries, getRequiredEntry } from '../content/load';
import SectionHeading from './SectionHeading.astro';
interface Props { heading: string; ariaLabel: string; }
const { heading, ariaLabel } = Astro.props;
const projects = await getEntries('project');
const { data: site } = await getRequiredEntry('site', 'site');
const base = import.meta.env.BASE_URL;
---
<section aria-label={ariaLabel}>
  <SectionHeading title={heading} />
  <div class="entries">
    {projects.map((project) => <article>
      <div class="split-row"><h3><a href={`${base}projects/${contentId(project).split('/').at(-1)}/`}>{project.data.title}</a><span class="project-category"> — {project.data.projectCategory}</span></h3>{project.data.date && <span class="meta">{project.data.date}</span>}</div>
      <p class="entry-subtitle">{project.data.stack.join(' · ')}</p>
      <ul>{project.data.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
      <div class="project-links no-print"><a href={`${base}projects/${contentId(project).split('/').at(-1)}/`}>{site.projectLinks.caseStudy}</a><a href={project.data.repository} target="_blank" rel="noopener noreferrer">{site.projectLinks.sourceCode}</a>{project.data.certificatePath && <a href={`${base}${project.data.certificatePath}`} target="_blank" rel="noopener noreferrer">{site.credentialLink}</a>}</div>
    </article>)}
  </div>
</section>
