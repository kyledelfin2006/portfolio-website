---
import ResumeLayout from '../layouts/ResumeLayout.astro';
import Education from '../components/Education.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Workshops from '../components/Workshops.astro';
import { getRequiredEntry } from '../content/load';
const pageEntry = await getRequiredEntry('pages/home', 'page-home');
const page = pageEntry.data;
---
<ResumeLayout title={page.title} description={page.description} resume>
  <div class="resume-sections">
    <Education {...page.sections.education} />
    <Experience {...page.sections.experience} />
    <Projects {...page.sections.projects} />
    <Skills {...page.sections.skills} />
    <Workshops {...page.sections.workshops} />
  </div>
</ResumeLayout>
