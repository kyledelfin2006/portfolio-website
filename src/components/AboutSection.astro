---
import SectionHeading from './SectionHeading.astro';
import type { TextEntryOf } from '../content/load';
interface Props { entry: TextEntryOf<'about'>; email: string; certificateLabel: string; }
const { entry, email, certificateLabel } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
---
<section>
  <SectionHeading title={data.title} />
  {data.itemTitle && <div class="split-row"><h3>{data.itemTitle}</h3>{data.meta && <span class="meta">{data.meta}</span>}</div>}
  <Content />
  {data.items && <div class="honor-items">
    {data.items.map((item) => <article class="honor-item">
      <div class="split-row"><h3>{item.title}</h3>{item.meta && <span class="meta">{item.meta}</span>}</div>
      <p>{item.summary}</p>
      {item.image && <figure class="honor-figure no-print">
        <img
          src={`${import.meta.env.BASE_URL}${item.image.path}`}
          alt={item.image.alt}
          width={item.image.width}
          height={item.image.height}
          loading="lazy"
          decoding="async"
        />
      </figure>}
      {item.certificatePath && <a class="credential-link no-print" href={`${import.meta.env.BASE_URL}${item.certificatePath}`} target="_blank" rel="noopener noreferrer">{certificateLabel}</a>}
    </article>)}
  </div>}
  {data.contactPrompt && <p>{data.contactPrompt} <a href={`mailto:${email}`}>{email}</a>.</p>}
  {data.resumeLink && <p><a href={`${import.meta.env.BASE_URL}resume.pdf`}>{data.resumeLink}</a></p>}
</section>
