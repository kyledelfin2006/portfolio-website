---
import SectionHeading from './SectionHeading.astro';
import type { TextEntryOf } from '../content/load';
interface Props {
  entry: TextEntryOf<'about'>;
  email: string;
  profiles: { label: string; url: string }[];
  certificateLabel: string;
}
const { entry, email, profiles, certificateLabel } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
const contactProfiles = profiles.filter(({ label }) => data.contactProfileLabels?.includes(label));
---
<section>
  <SectionHeading title={data.title} />
  {data.itemTitle && <div class="split-row"><h3>{data.itemTitle}</h3>{data.meta && <span class="meta">{data.meta}</span>}</div>}
  <Content />
  {data.items && <div class="honor-items">
    {data.items.map((item) => <article class="honor-item">
      <div class="split-row"><h3>{item.title}</h3>{item.meta && <span class="meta">{item.meta}</span>}</div>
      <p>{item.summary}</p>
      {item.images && <div class="honor-gallery no-print">
        {item.images.map((image) => <figure class="honor-figure">
          <img
            src={`${import.meta.env.BASE_URL}${image.path}`}
            alt={image.alt}
            width={image.width}
            height={image.height}
            loading="lazy"
            decoding="async"
          />
        </figure>)}
      </div>}
      {item.certificatePath && <a class="credential-link no-print" href={`${import.meta.env.BASE_URL}${item.certificatePath}`} target="_blank" rel="noopener noreferrer">{certificateLabel}</a>}
    </article>)}
  </div>}
  {data.contactProfileLabels && <div class="contact-links">
    <a href={`mailto:${email}`}>{email}</a>
    {contactProfiles.map((profile) => <><span aria-hidden="true">·</span><a href={profile.url} target="_blank" rel="noopener noreferrer">{profile.label}</a></>)}
  </div>}
</section>
